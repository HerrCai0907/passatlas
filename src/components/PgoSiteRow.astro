---
import type { PgoSiteMeta } from '../data/pgo';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { pgoSlug, type PgoEntry } from '../lib/pgo';
import { url } from '../lib/url';

interface Props {
  entry: PgoEntry;
  meta: PgoSiteMeta;
  index: number;
  locale: Locale;
}

const { entry, meta, index, locale } = Astro.props;
const { title, subtitle, summary } = entry.data;
const kindLabel =
  meta.kind === 'counter' ? t(locale, 'pgo.kind.counter') : t(locale, 'pgo.kind.value');
---

<a class="pgo-row" href={url(`/passes/pgo-instr-gen/${pgoSlug(entry)}/`, locale)}>
  <span class="pgo-row__no">{String(index).padStart(2, '0')}</span>

  <span class="pgo-row__main">
    <span class="pgo-row__head">
      <span class="pgo-row__name">{title}</span>
      <span class="pgo-row__sub">{subtitle}</span>
      {meta.experimental ? <span class="pgo-row__tag">{t(locale, 'pgo.detail.experimental')}</span> : null}
    </span>
    <span class="pgo-row__summary">{summary}</span>
    <span class="pgo-row__feeds">
      <span class="pgo-row__label">{t(locale, 'pgo.site.feeds')}</span>
      {meta.feeds[locale]}
    </span>
  </span>

  <span class="pgo-row__side">
    <span class="pgo-row__kind">{kindLabel}</span>
    <code class="pgo-row__record">{meta.record}</code>
  </span>

  <span class="pgo-row__arrow" aria-hidden="true">→</span>
</a>

<style>
  .pgo-row {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto 24px;
    align-items: center;
    gap: 18px;
    padding: 18px 14px 18px 12px;
    border-bottom: 1px solid var(--line);
    border-left: 2px solid transparent;
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  .pgo-row:first-of-type {
    border-top: 1px solid var(--line);
  }

  .pgo-row:hover {
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .pgo-row__no {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .pgo-row__main {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .pgo-row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .pgo-row__name {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pgo-row__sub {
    font-size: 13px;
    color: var(--muted);
  }

  .pgo-row__tag {
    padding: 1px 8px;
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-strong);
  }

  .pgo-row__summary {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .pgo-row__feeds {
    font-size: 12px;
    line-height: 1.6;
    color: var(--faint);
  }

  .pgo-row__label {
    margin-right: 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pgo-row__side {
    display: grid;
    gap: 5px;
    justify-items: end;
    text-align: right;
  }

  .pgo-row__kind {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .pgo-row__record {
    padding: 1px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 10.5px;
    color: var(--accent-strong);
    white-space: nowrap;
  }

  .pgo-row__arrow {
    font-size: 14px;
    color: var(--faint);
    transition:
      transform 0.16s var(--ease),
      color 0.16s var(--ease);
  }

  .pgo-row:hover .pgo-row__arrow {
    transform: translateX(3px);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .pgo-row {
      grid-template-columns: 30px minmax(0, 1fr) 20px;
      gap: 12px;
      padding-block: 15px;
    }

    .pgo-row__side {
      display: none;
    }

    .pgo-row__summary {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .pgo-row__feeds {
      display: none;
    }
  }
</style>
