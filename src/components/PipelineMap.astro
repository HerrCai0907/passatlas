---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import type { PipelineStage } from '../data/pipeline';
import { passSlug, type PassEntry } from '../lib/passes';
import { url } from '../lib/url';

interface Props {
  stages: PipelineStage[];
  pages: PassEntry[];
  locale: Locale;
}

const { stages, pages, locale } = Astro.props;
const pagesBySlug = new Map(pages.map((pass) => [passSlug(pass), pass]));

const levelKeys = {
  module: 'passes.pipeline.level.module',
  cgscc: 'passes.pipeline.level.cgscc',
  function: 'passes.pipeline.level.function',
  loop: 'passes.pipeline.level.loop',
  vectorize: 'passes.pipeline.level.vectorize',
  codegen: 'passes.pipeline.level.codegen',
} as const;
---

<div class="map-shell">
  <div class="legend" role="group" aria-label={t(locale, 'passes.pipeline.legendLabel')}>
    <span class="legend__item">
      <span class="legend__sample legend__sample--ready" aria-hidden="true"></span>
      {t(locale, 'passes.pipeline.legendReady')}
    </span>
    <span class="legend__item">
      <span class="legend__sample legend__sample--planned" aria-hidden="true"></span>
      {t(locale, 'passes.pipeline.legendPlanned')}
    </span>
  </div>

  <ol class="map" aria-label={t(locale, 'passes.pipeline.mapLabel')}>
    {
      stages.map((stage, index) => (
        <li class={`stage stage--${stage.level}`}>
          {index > 0 ? (
            stage.adaptor || stage.entry ? (
              <p class="connector">
                <span class="connector__arrow" aria-hidden="true">↓</span>
                {stage.adaptor ? (
                  <>
                    <span class="connector__label">{t(locale, 'passes.pipeline.adaptor')}</span>
                    <code>{stage.adaptor}</code>
                  </>
                ) : (
                  <span class="connector__entry">{stage.entry?.[locale]}</span>
                )}
              </p>
            ) : (
              <p class="connector connector--plain" aria-hidden="true">
                <span class="connector__arrow">↓</span>
              </p>
            )
          ) : null}

          <article class="panel">
            <header class="panel__head">
              <span class="panel__no" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="panel__title">
                <h3>{stage.title[locale]}</h3>
                <span class="panel__level">{t(locale, levelKeys[stage.level])}</span>
              </div>
              <code class="panel__manager">{stage.manager}</code>
            </header>
            <p class="panel__note">{stage.note[locale]}</p>
            <ul class="nodes">
              {stage.passes.map((item) => {
                const page = pagesBySlug.get(item.page ?? item.name);
                const name = item.label ?? item.name;
                return (
                  <li
                    class:list={[
                      'node',
                      `cat-${item.category}`,
                      {
                        'node--ready': Boolean(page),
                        'node--planned': !page,
                        'node--helper': item.kind === 'helper',
                      },
                    ]}
                  >
                    {page ? (
                      <a
                        class="node__inner"
                        href={url(`/passes/${passSlug(page)}/`, locale)}
                      >
                        <span class="node__dot" aria-hidden="true" />
                        <span class="node__name">{name}</span>
                        {item.kind === 'helper' ? (
                          <span class="node__kind">{t(locale, 'passes.pipeline.helper')}</span>
                        ) : null}
                        {item.repeat ? (
                          <span
                            class="node__repeat"
                            title={t(locale, 'passes.pipeline.repeat')}
                          >
                            <span aria-hidden="true">↻</span>
                            <span class="sr-only">{t(locale, 'passes.pipeline.repeat')}</span>
                          </span>
                        ) : null}
                      </a>
                    ) : (
                      <span class="node__inner">
                        <span class="node__dot" aria-hidden="true" />
                        <span class="node__name">{name}</span>
                        {item.kind === 'helper' ? (
                          <span class="node__kind">{t(locale, 'passes.pipeline.helper')}</span>
                        ) : null}
                        {item.repeat ? (
                          <span
                            class="node__repeat"
                            title={t(locale, 'passes.pipeline.repeat')}
                          >
                            <span aria-hidden="true">↻</span>
                            <span class="sr-only">{t(locale, 'passes.pipeline.repeat')}</span>
                          </span>
                        ) : null}
                        <span class="sr-only">{t(locale, 'passes.pipeline.planned')}</span>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>

  <p class="footnote">{t(locale, 'passes.pipeline.footnote')}</p>
</div>

<style>
  .map-shell {
    margin-top: 8px;
  }

  /* ---------- 图例 ---------- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend__sample {
    display: inline-block;
    width: 26px;
    height: 13px;
    border-radius: 999px;
  }

  .legend__sample--ready {
    border: 1px solid color-mix(in srgb, var(--cat-scalar) 38%, var(--line));
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--cat-dataflow) 16%, var(--surface)),
      color-mix(in srgb, var(--cat-loop) 16%, var(--surface)),
      color-mix(in srgb, var(--cat-vectorize) 16%, var(--surface))
    );
  }

  .legend__sample--planned {
    border: 1px dashed var(--line-strong);
    background: transparent;
  }

  /* ---------- 管线 ---------- */
  .map {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    position: relative;
    padding-left: 34px;
  }

  /* 左侧的流程线：每个 stage 自己画一段，首尾相接 */
  .stage::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .stage:first-child::before {
    top: 25px;
  }

  .stage:last-child::before {
    bottom: 18px;
  }

  /* 流程线上的节点圆点 */
  .stage::after {
    content: '';
    position: absolute;
    z-index: 1;
    left: 6px;
    top: 21px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
  }

  .stage:first-child::after {
    border-color: var(--accent);
    background: var(--accent);
  }

  .connector {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 7px;
    margin: 0;
    padding: 7px 0 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    color: var(--faint);
    overflow-wrap: anywhere;
  }

  .connector--plain {
    padding-block: 4px 8px;
  }

  .connector__arrow {
    color: var(--accent);
    font-size: 12px;
    line-height: 1;
  }

  .connector__label {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 9.5px;
    color: var(--muted);
  }

  .connector code {
    font-size: 10.5px;
    color: var(--ink-soft);
  }

  .connector__entry {
    color: var(--muted);
  }

  .panel {
    padding: 17px 20px 19px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .panel__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 12px;
  }

  .panel__no {
    padding: 1px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .panel__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    min-width: 0;
  }

  .panel__title h3 {
    font-size: clamp(18px, 2vw, 21px);
  }

  .panel__level {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel__manager {
    justify-self: end;
    max-width: 46ch;
    font-size: 10.5px;
    color: var(--faint);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .panel__note {
    margin-top: 7px;
    max-width: 82ch;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--muted);
  }

  .nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .node {
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    transition:
      transform 0.16s var(--ease),
      border-color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  .node__inner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 27px;
    padding: 3px 10px 3px 8px;
    text-decoration: none;
    color: inherit;
  }

  .node__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cat);
  }

  .node__name {
    white-space: nowrap;
  }

  .node__kind {
    padding-left: 6px;
    border-left: 1px solid color-mix(in srgb, var(--cat) 30%, transparent);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cat);
  }

  .node__repeat {
    color: var(--faint);
    font-size: 11px;
  }

  /* 已收录：正常颜色，可点，hover 时轻微抬起 */
  .node--ready {
    border-color: color-mix(in srgb, var(--cat) 34%, var(--line));
    background: color-mix(in srgb, var(--cat) 7%, var(--surface));
    color: var(--ink);
  }

  .node--ready:hover {
    transform: translateY(-1px);
    border-color: var(--cat);
    background: color-mix(in srgb, var(--cat) 11%, var(--surface));
  }

  .node--ready:focus-within {
    border-color: var(--cat);
  }

  /* 待绘制：灰色字体 + 虚线边框，不可点 */
  .node--planned {
    border-style: dashed;
    border-color: var(--line-strong);
    background: transparent;
    color: var(--faint);
  }

  .node--planned .node__dot {
    border: 1px solid currentColor;
    background: transparent;
  }

  /* InlineFunction 是 inliner 内部的一步，不是独立 pass */
  .node--helper .node__name::before {
    content: '↳ ';
    color: var(--cat);
  }

  .node--helper .node__name {
    white-space: normal;
  }

  .footnote {
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    max-width: 86ch;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--faint);
  }

  @media (max-width: 760px) {
    .stage {
      padding-left: 26px;
    }

    .stage::before {
      left: 6px;
    }

    .stage::after {
      left: 2px;
    }

    .panel {
      padding: 14px 14px 16px;
    }

    .panel__head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .panel__manager {
      grid-column: 1 / -1;
      justify-self: start;
      max-width: 100%;
      text-align: left;
    }

    .panel__note {
      font-size: 13px;
    }
  }

  @media (max-width: 440px) {
    .stage {
      padding-left: 0;
    }

    .stage::before,
    .stage::after {
      display: none;
    }

    .connector {
      padding-left: 2px;
    }

    .nodes {
      gap: 6px;
    }

    .node {
      font-size: 11.5px;
    }
  }
</style>
