---
import { nav, site } from '../site';
import { localeMeta, otherLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { isActive, switchLocaleUrl, url } from '../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = Astro.url.pathname;
const targetLocale = otherLocale(locale);
const targetMeta = localeMeta[targetLocale];
const isNotFound = path.replace(/\/+$/, '').endsWith('/404');
// 404 没有英文版本，切换语言时回到首页，避免把读者送到另一个 404
const switchHref = isNotFound
  ? url('/', targetLocale)
  : `${switchLocaleUrl(path, targetLocale)}${Astro.url.search}`;
const brandSubtitle = locale === 'zh' ? site.nameZh : site.nameEn;
const switchLabel = t(locale, targetLocale === 'en' ? 'lang.toEnglish' : 'lang.toChinese');
---

<header class="site-head">
  <div class="container site-head__inner">
    <a
      class="brand"
      href={url('/', locale)}
      aria-label={t(locale, 'site.homeAria', { name: site.name })}
    >
      <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect x="3.5" y="3.5" width="25" height="25" rx="7.5" stroke="currentColor" stroke-opacity="0.22" />
        <path d="M9 11h9M9 16h6M9 21h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <path
          d="M18.5 16h6m0 0-2.7-2.7M24.5 16l-2.7 2.7"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="brand__text">
        <strong>PassAtlas</strong>
        <span>{brandSubtitle}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t(locale, 'nav.main')}>
      {
        nav.map((item) => (
          <a
            href={url(item.href, locale)}
            aria-current={isActive(path, item.href, locale) ? 'page' : undefined}
          >
            {item.label[locale]}
          </a>
        ))
      }
    </nav>

    <nav class="lang" aria-label={t(locale, 'lang.switch')}>
      <a
        href={switchHref}
        hreflang={targetMeta.htmlLang}
        lang={targetMeta.htmlLang}
        aria-label={switchLabel}
        title={switchLabel}
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="8" cy="8" r="6.2" />
          <path d="M1.8 8h12.4M8 1.8c1.7 1.7 2.6 3.9 2.6 6.2S9.7 12.5 8 14.2C6.3 12.5 5.4 10.3 5.4 8S6.3 3.5 8 1.8Z" />
        </svg>
        <span class="lang__full">{targetMeta.label}</span>
        <span class="lang__short" aria-hidden="true">{targetMeta.short}</span>
      </a>
    </nav>

    <a class="repo" href={site.github} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
  }

  .site-head__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand__mark {
    width: 30px;
    height: 30px;
    flex: none;
  }

  .brand__text {
    display: grid;
    line-height: 1.15;
  }

  .brand__text strong {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand__text span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav a {
    position: relative;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }

  .nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 550;
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }

  .lang a,
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.16s var(--ease),
      border-color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  .lang a {
    padding-inline: 10px;
  }

  .lang svg,
  .repo svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .lang__short {
    display: none;
  }

  .lang a:hover,
  .repo:hover {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--surface);
  }

  @media (max-width: 760px) {
    .site-head__inner {
      gap: 8px;
    }

    .brand__text span {
      display: none;
    }

    .nav a {
      padding-inline: 8px;
    }

    .lang__full {
      display: none;
    }

    .lang__short {
      display: inline;
    }

    .lang a {
      padding: 7px 9px;
    }

    .repo span {
      display: none;
    }

    .repo {
      padding: 7px;
    }
  }

  @media (max-width: 480px) {
    .site-head__inner {
      gap: 4px;
    }

    .nav {
      gap: 0;
    }

    .nav a {
      padding-inline: 6px;
      font-size: 13px;
    }

    .lang svg {
      display: none;
    }
  }
</style>
