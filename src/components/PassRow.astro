---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { categoryName, difficultyLabel } from '../lib/categories';
import { passSlug, passSubtitle, type PassEntry } from '../lib/passes';
import { url } from '../lib/url';

interface Props {
  pass: PassEntry;
  index: number;
  locale: Locale;
}

const { pass, index, locale } = Astro.props;
const { title, summary, category, difficulty, stage } = pass.data;
const label = difficultyLabel(difficulty, locale);
---

<a class={`row cat-${category}`} href={url(`/passes/${passSlug(pass)}/`, locale)}>
  <span class="row__no">{String(index).padStart(2, '0')}</span>

  <span class="row__main">
    <span class="row__head">
      <span class="row__name">{title}</span>
      <span class="row__zh">{passSubtitle(pass)}</span>
      <span class="row__cat">{categoryName(category, locale)}</span>
    </span>
    <span class="row__summary">{summary}</span>
  </span>

  <span class="row__side">
    <span class="row__stage">{stage.length > 0 ? stage.join(' · ') : '—'}</span>
    <span class="row__diff" title={t(locale, 'row.difficultyTitle', { level: label })}>
      <span aria-hidden="true">{'●'.repeat(difficulty)}{'○'.repeat(3 - difficulty)}</span>
      <span class="sr-only">{t(locale, 'row.difficultyTitle', { level: label })}</span>
    </span>
  </span>

  <span class="row__arrow" aria-hidden="true">→</span>
</a>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto 28px;
    align-items: center;
    gap: 18px;
    padding: 16px 14px 16px 12px;
    border-bottom: 1px solid var(--line);
    border-left: 2px solid transparent;
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  .row:first-of-type {
    border-top: 1px solid var(--line);
  }

  .row:hover {
    border-left-color: var(--cat);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .row__no {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .row__main {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .row__name {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .row__zh {
    font-size: 13px;
    color: var(--muted);
  }

  .row__cat {
    padding: 1px 8px;
    border: 1px solid color-mix(in srgb, var(--cat) 30%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--cat);
  }

  .row__summary {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .row__side {
    display: grid;
    gap: 4px;
    justify-items: end;
    text-align: right;
  }

  .row__stage {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--faint);
    white-space: nowrap;
  }

  .row__diff {
    font-size: 8px;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--cat) 55%, var(--faint));
  }

  .row__arrow {
    font-size: 14px;
    color: var(--faint);
    transition:
      transform 0.16s var(--ease),
      color 0.16s var(--ease);
  }

  .row:hover .row__arrow {
    transform: translateX(3px);
    color: var(--cat);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 32px minmax(0, 1fr) 20px;
      gap: 12px;
      padding-block: 14px;
    }

    .row__side {
      display: none;
    }

    .row__summary {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
