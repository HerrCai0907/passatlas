---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import StepPlayer from '../components/StepPlayer';
import CFGViewer from '../components/CFGViewer';
import PipelineStrip from '../components/PipelineStrip.astro';
import { cfgSamples } from '../data/cfg-samples';
import { getDemo } from '../demos/registry';
import { categories, difficultyLabels } from '../lib/categories';
import { site } from '../site';
import { url } from '../lib/url';

interface Props {
  pass: CollectionEntry<'passes'>;
  prev?: CollectionEntry<'passes'>;
  next?: CollectionEntry<'passes'>;
}

const { pass, prev, next } = Astro.props;
const { title, zh, summary, category, difficulty, stage, tags, demo, cfg, source } = pass.data;
const categoryMeta = categories[category];
const demoData = getDemo(demo);
const cfgSample = cfg ? cfgSamples.find((sample) => sample.id === cfg) : undefined;
const editUrl = `${site.github}/blob/main/src/content/passes/${pass.id}.mdx`;
---

<BaseLayout title={title} description={summary}>
  <article class={`pass cat-${category}`}>
    <div class="container">
      <nav class="crumbs" aria-label="面包屑">
        <a href={url('/')}>PassAtlas</a>
        <span aria-hidden="true">/</span>
        <a href={url('/passes/')}>图鉴</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="pass__head">
        <p class="eyebrow">{categoryMeta.zh} · {categoryMeta.en}</p>
        <h1 class="pass__title">{title}</h1>
        <p class="pass__zh">{zh}</p>
        <p class="lead pass__summary">{summary}</p>

        <div class="pass__meta">
          <span class="chip chip--cat">{categoryMeta.zh}</span>
          <span class="chip">难度 {difficultyLabels[difficulty]}</span>
          {tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>

        <PipelineStrip stage={stage} />
      </header>

      {
        demoData && (
          <section class="pass__demo" aria-labelledby="demo-heading">
            <div class="pass__demo-head">
              <h2 id="demo-heading">分步动画</h2>
              <p class="muted">
                点按「下一步」，或用键盘 <kbd>←</kbd> <kbd>→</kbd> 单步，<kbd>空格</kbd> 播放。
              </p>
            </div>
            <StepPlayer demo={demoData} client:visible />
          </section>
        )
      }

      {
        cfgSample && !demoData && (
          <section class="pass__cfg" aria-labelledby="cfg-heading">
            <div class="pass__demo-head">
              <h2 id="cfg-heading">控制流图</h2>
              <p class="muted">基本块、跳转与分支条件的一张地图。</p>
            </div>
            <CFGViewer
              ir={cfgSample.ir}
              title={`${title} 的控制流图`}
              height={520}
              client:visible
            />
          </section>
        )
      }

      <div class="pass__body prose">
        <slot />
      </div>

      {
        source && (
          <p class="pass__source">
            在 LLVM 源码中：
            <a href={`${site.llvmSource}/tree/main/${source}`} target="_blank" rel="noopener noreferrer">
              <code>{source}</code> ↗
            </a>
          </p>
        )
      }

      <nav class="pager" aria-label="上一篇 / 下一篇">
        {
          prev ? (
            <a class="pager__item pager__item--prev" href={url(`/passes/${prev.id}/`)}>
              <span class="pager__dir">← 上一篇</span>
              <span class="pager__name">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="pager__item pager__item--next" href={url(`/passes/${next.id}/`)}>
              <span class="pager__dir">下一篇 →</span>
              <span class="pager__name">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      <p class="pass__edit">
        <a href={editUrl} target="_blank" rel="noopener noreferrer">发现错误？在 GitHub 上编辑这一页 ↗</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .pass {
    padding-top: 28px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .pass__head {
    max-width: 840px;
    margin-top: 26px;
    padding-bottom: clamp(28px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
  }

  .pass__title {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .pass__zh {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
  }

  .pass__summary {
    margin-top: 16px;
    max-width: 720px;
  }

  .pass__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .pass__demo {
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pass__demo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 14px;
  }

  .pass__demo-head h2 {
    font-size: 22px;
  }

  .pass__demo-head p {
    font-size: 13px;
    margin: 0;
  }

  .pass__demo-head kbd {
    padding: 1px 5px;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--surface);
    font-size: 11px;
    color: var(--ink-soft);
  }

  .pass__cfg {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .pass__body {
    max-width: var(--wrap-narrow);
    margin-top: clamp(36px, 5vw, 56px);
  }

  .pass__source {
    max-width: var(--wrap-narrow);
    margin-top: 28px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px;
    color: var(--muted);
  }

  .pass__source code {
    color: var(--accent-strong);
    word-break: break-all;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: var(--wrap-narrow);
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .pager__item {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .pager__item:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .pager__item--next {
    text-align: right;
  }

  .pager__dir {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .pager__name {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .pass__edit {
    margin-top: 26px;
    font-size: 12.5px;
    color: var(--faint);
  }

  .pass__edit a {
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__item--next {
      text-align: left;
    }
  }
</style>
