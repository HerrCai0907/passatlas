---
import BaseLayout from './BaseLayout.astro';
import StepPlayer from '../components/StepPlayer';
import CFGViewer from '../components/CFGViewer';
import PipelineStrip from '../components/PipelineStrip.astro';
import { cfgSamples } from '../data/cfg-samples';
import { getDemo } from '../demos/registry';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { categories, categoryName, difficultyLabel } from '../lib/categories';
import { pipelineStageNumber, stagesForPass, stageAnchor } from '../lib/pipeline';
import { passSlug, passSubtitle, type PassEntry } from '../lib/passes';
import { site, llvmSourceUrl } from '../site';
import { url } from '../lib/url';

interface Props {
  pass: PassEntry;
  locale: Locale;
  prev?: PassEntry;
  next?: PassEntry;
}

const { pass, locale, prev, next } = Astro.props;
const { title, summary, category, stage, tags, demo, cfg, source } = pass.data;
const categoryMeta = categories[category];
const difficulty = pass.data.difficulty;
const demoData = getDemo(demo, locale);
const cfgSample = cfg ? cfgSamples.find((sample) => sample.id === cfg) : undefined;
const editUrl = `${site.github}/blob/main/src/content/passes/${pass.id}.mdx`;
const categoryLine =
  locale === 'zh' ? `${categoryMeta.zh} · ${categoryMeta.en}` : categoryMeta.en;
const slug = passSlug(pass);
const passStages = stagesForPass(slug);
const atlasHref = url('/passes/', locale);
---

<BaseLayout title={title} description={summary} locale={locale}>
  <article class={`pass cat-${category}`}>
    <div class="container">
      {/* 页面最开头：直接跳到图鉴里这个 pass 出现的管线阶段 */}
      <nav class="pass__where" aria-label={t(locale, 'pass.where')}>
        <span class="pass__where-label">{t(locale, 'pass.where')}</span>
        {
          passStages.length > 0 ? (
            passStages.map((stage) => (
              <a
                class="pass__where-link"
                href={`${atlasHref}#${stageAnchor(stage.id)}`}
                aria-label={t(locale, 'pass.whereLink', { title: stage.title[locale] })}
              >
                <span class="pass__where-no" aria-hidden="true">
                  {String(pipelineStageNumber(stage.id)).padStart(2, '0')}
                </span>
                <span class="pass__where-name">{stage.title[locale]}</span>
                <span class="pass__where-arrow" aria-hidden="true">↘</span>
              </a>
            ))
          ) : (
            <a class="pass__where-link" href={`${atlasHref}#pipeline`}>
              <span class="pass__where-name">{t(locale, 'passes.pipeline.title')}</span>
              <span class="pass__where-arrow" aria-hidden="true">↘</span>
            </a>
          )
        }
      </nav>

      <nav class="crumbs" aria-label={t(locale, 'pass.crumbs')}>
        <a href={url('/', locale)}>PassAtlas</a>
        <span aria-hidden="true">/</span>
        <a href={url('/passes/', locale)}>{t(locale, 'pass.atlas')}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class="pass__head">
        <p class="eyebrow">{categoryLine}</p>
        <h1 class="pass__title">{title}</h1>
        <p class="pass__zh">{passSubtitle(pass)}</p>
        <p class="lead pass__summary">{summary}</p>

        <div class="pass__meta">
          <span class="chip chip--cat">{categoryName(category, locale)}</span>
          <span class="chip">{t(locale, 'pass.difficulty', { level: difficultyLabel(difficulty, locale) })}</span>
          {tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>

        {
          stage.length > 0 ? (
            <PipelineStrip stage={stage} locale={locale} />
          ) : (
            <p class="pass__stage-none">{t(locale, 'pass.stageNone')}</p>
          )
        }
      </header>

      {
        demoData && (
          <section class="pass__demo" aria-labelledby="demo-heading">
            <div class="pass__demo-head">
              <h2 id="demo-heading">{t(locale, 'pass.demoHeading')}</h2>
              <p
                class="muted"
                set:html={t(
                  locale,
                  demoData.format === 'mir' ? 'pass.demoHintMir' : 'pass.demoHint',
                )}
              />
            </div>
            <StepPlayer demo={demoData} locale={locale} client:visible />
          </section>
        )
      }

      {
        cfgSample && !demoData && (
          <section class="pass__cfg" aria-labelledby="cfg-heading">
            <div class="pass__demo-head">
              <h2 id="cfg-heading">{t(locale, 'pass.cfgHeading')}</h2>
              <p class="muted">{t(locale, 'pass.cfgHint')}</p>
            </div>
            <CFGViewer
              ir={cfgSample.ir}
              locale={locale}
              title={t(locale, 'pass.cfgTitle', { title })}
              height={520}
              client:visible
            />
          </section>
        )
      }

      <div class="pass__body prose">
        <slot />
      </div>

      {
        source && (
          <p class="pass__source">
            {t(locale, 'pass.sourcePrefix')}
            <a href={llvmSourceUrl(source)} target="_blank" rel="noopener noreferrer">
              <code>{source}</code> ↗
            </a>
          </p>
        )
      }

      <nav class="pager" aria-label={t(locale, 'pass.pager')}>
        {
          prev ? (
            <a class="pager__item pager__item--prev" href={url(`/passes/${passSlug(prev)}/`, locale)}>
              <span class="pager__dir">{t(locale, 'pass.prev')}</span>
              <span class="pager__name">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="pager__item pager__item--next" href={url(`/passes/${passSlug(next)}/`, locale)}>
              <span class="pager__dir">{t(locale, 'pass.next')}</span>
              <span class="pager__name">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      <p class="pass__edit">
        <a href={editUrl} target="_blank" rel="noopener noreferrer">{t(locale, 'pass.edit')}</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .pass {
    padding-top: 28px;
  }

  /* ---------- 顶部定位条：跳到 /passes 里这个 pass 出现的阶段 ---------- */
  .pass__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 8px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .pass__where-label {
    margin-right: 2px;
    padding-right: 10px;
    border-right: 1px solid var(--line);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .pass__where-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 9px 3px 8px;
    border: 1px solid color-mix(in srgb, var(--cat, var(--accent)) 30%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat, var(--accent)) 7%, var(--surface));
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      border-color 0.16s var(--ease),
      background-color 0.16s var(--ease),
      transform 0.16s var(--ease);
  }

  .pass__where-link:hover {
    border-color: var(--cat, var(--accent));
    background: color-mix(in srgb, var(--cat, var(--accent)) 12%, var(--surface));
    transform: translateY(-1px);
  }

  .pass__where-no {
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .pass__where-name {
    color: var(--ink);
  }

  .pass__where-arrow {
    font-size: 11px;
    color: var(--cat, var(--accent));
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .pass__head {
    max-width: 840px;
    margin-top: 26px;
    padding-bottom: clamp(28px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
  }

  .pass__title {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .pass__zh {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
  }

  .pass__summary {
    margin-top: 16px;
    max-width: 720px;
  }

  .pass__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .pass__stage-none {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .pass__demo {
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pass__demo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 14px;
  }

  .pass__demo-head h2 {
    font-size: 22px;
  }

  .pass__demo-head p {
    font-size: 13px;
    margin: 0;
  }

  .pass__demo-head kbd {
    padding: 1px 5px;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--surface);
    font-size: 11px;
    color: var(--ink-soft);
  }

  .pass__cfg {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .pass__body {
    max-width: var(--wrap-narrow);
    margin-top: clamp(36px, 5vw, 56px);
  }

  .pass__source {
    max-width: var(--wrap-narrow);
    margin-top: 28px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px;
    color: var(--muted);
  }

  .pass__source code {
    color: var(--accent-strong);
    word-break: break-all;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: var(--wrap-narrow);
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .pager__item {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .pager__item:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .pager__item--next {
    text-align: right;
  }

  .pager__dir {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .pager__name {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
  }

  .pass__edit {
    margin-top: 26px;
    font-size: 12.5px;
    color: var(--faint);
  }

  .pass__edit a {
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__item--next {
      text-align: left;
    }
  }
</style>
