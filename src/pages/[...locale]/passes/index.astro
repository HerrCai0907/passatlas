---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PassRow from '../../../components/PassRow.astro';
import PipelineMap from '../../../components/PipelineMap.astro';
import PassRegistry from '../../../components/PassRegistry.astro';
import { pipelineStages } from '../../../data/pipeline';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { categories, categoryDescription, categoryName, categoryOrder } from '../../../lib/categories';
import { passesForLocale } from '../../../lib/passes';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const allPasses = await getCollection('passes', ({ data }) => data.status === 'ready');
const passes = passesForLocale(allPasses, locale);

let cursor = 0;
const groups = categoryOrder
  .map((id) => {
    const items = passes.filter((p) => p.data.category === id);
    const group = { id, items, start: cursor + 1 };
    cursor += items.length;
    return group;
  })
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title={t(locale, 'passes.metaTitle')}
  description={t(locale, 'passes.metaDescription')}
  locale={locale}
>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{t(locale, 'passes.eyebrow')}</p>
      <h1 class="page-head__title">{t(locale, 'passes.heading')}</h1>
      <p class="lead page-head__lead">{t(locale, 'passes.lead')}</p>

      <nav class="jump" aria-label={t(locale, 'passes.jump')}>
        {
          groups.map((group) => (
            <a class="chip chip--cat" href={`#${group.id}`}>
              {categoryName(group.id, locale)}
              <span class="jump__count">{group.items.length}</span>
            </a>
          ))
        }
        <a class="chip" href="#pipeline">
          {t(locale, 'passes.pipeline.jump')}
          <span class="jump__count" aria-hidden="true">↓</span>
        </a>
      </nav>
    </div>
  </header>

  <div class="container">
    {
      groups.map((group) => (
        <section class={`group cat-${group.id}`} id={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="group__head">
            <div class="group__label">
              <span class="group__dot" aria-hidden="true" />
              <h2 id={`${group.id}-title`}>{categoryName(group.id, locale)}</h2>
              {locale === 'zh' ? (
                <span class="group__en">{categories[group.id].en}</span>
              ) : null}
            </div>
            <p class="group__desc">{categoryDescription(group.id, locale)}</p>
          </header>
          <div class="rows">
            {group.items.map((pass, i) => (
              <PassRow pass={pass} index={group.start + i} locale={locale} />
            ))}
          </div>
        </section>
      ))
    }

    <section class="pipeline" id="pipeline" aria-labelledby="pipeline-title">
      <header class="pipeline__head">
        <div class="pipeline__intro">
          <p class="eyebrow">{t(locale, 'passes.pipeline.eyebrow')}</p>
          <h2 id="pipeline-title">{t(locale, 'passes.pipeline.title')}</h2>
        </div>
        <p class="muted pipeline__lead">{t(locale, 'passes.pipeline.body')}</p>
      </header>

      <p class="pipeline__pgo">
        {t(locale, 'passes.pipeline.pgo')}
        <a href={url('/pgo/', locale)}>
          {t(locale, 'passes.pipeline.pgoLink')} <span aria-hidden="true">→</span>
        </a>
      </p>

      <PipelineMap stages={pipelineStages} pages={passes} locale={locale} />
      <PassRegistry pages={passes} locale={locale} />

      <p class="pipeline__cta">
        <a class="btn btn--ghost" href={url('/about/', locale)}>
          {t(locale, 'passes.pipeline.cta')} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
  }

  .page-head__title {
    margin-top: 10px;
    font-size: clamp(38px, 5.4vw, 60px);
    letter-spacing: -0.03em;
  }

  .page-head__lead {
    margin-top: 14px;
    max-width: 62ch;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .jump__count {
    font-size: 10px;
    opacity: 0.6;
  }

  .group {
    padding-block: clamp(32px, 4.5vw, 52px);
    border-bottom: 1px solid var(--line);
  }

  .group__head {
    display: grid;
    gap: 6px;
    margin-bottom: 22px;
  }

  .group__label {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .group__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat);
    align-self: center;
  }

  .group__label h2 {
    font-size: clamp(22px, 2.6vw, 28px);
  }

  .group__en {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .group__desc {
    font-size: 14.5px;
    color: var(--muted);
    max-width: 68ch;
  }

  .rows {
    margin-top: 6px;
  }

  /* ---------- 管线地图 ---------- */
  .pipeline {
    padding-block: clamp(40px, 6vw, 64px);
  }

  .pipeline__head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 10px clamp(24px, 4vw, 56px);
    margin-bottom: 26px;
  }

  .pipeline__intro h2 {
    margin-top: 8px;
    font-size: clamp(26px, 3vw, 34px);
  }

  .pipeline__lead {
    max-width: 66ch;
    font-size: 14.5px;
  }

  .pipeline__pgo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: -8px 0 18px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px;
    color: var(--muted);
  }

  .pipeline__pgo a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-strong);
    text-decoration: none;
  }

  .pipeline__pgo a:hover {
    text-decoration: underline;
  }

  .pipeline__cta {
    margin-top: 26px;
  }

  @media (max-width: 760px) {
    .pipeline__head {
      grid-template-columns: 1fr;
    }
  }
</style>
