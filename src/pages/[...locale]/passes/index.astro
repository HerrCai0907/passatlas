---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PassRow from '../../../components/PassRow.astro';
import { roadmap } from '../../../data/roadmap';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { categories, categoryDescription, categoryName, categoryOrder } from '../../../lib/categories';
import { passesForLocale } from '../../../lib/passes';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const allPasses = await getCollection('passes', ({ data }) => data.status === 'ready');
const passes = passesForLocale(allPasses, locale);

let cursor = 0;
const groups = categoryOrder
  .map((id) => {
    const items = passes.filter((p) => p.data.category === id);
    const group = { id, items, start: cursor + 1 };
    cursor += items.length;
    return group;
  })
  .filter((group) => group.items.length > 0);

const planned = roadmap;
---

<BaseLayout
  title={t(locale, 'passes.metaTitle')}
  description={t(locale, 'passes.metaDescription')}
  locale={locale}
>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{t(locale, 'passes.eyebrow')}</p>
      <h1 class="page-head__title">{t(locale, 'passes.heading')}</h1>
      <p class="lead page-head__lead">{t(locale, 'passes.lead')}</p>

      <nav class="jump" aria-label={t(locale, 'passes.jump')}>
        {
          groups.map((group) => (
            <a class="chip chip--cat" href={`#${group.id}`}>
              {categoryName(group.id, locale)}
              <span class="jump__count">{group.items.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="container">
    {
      groups.map((group) => (
        <section class={`group cat-${group.id}`} id={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="group__head">
            <div class="group__label">
              <span class="group__dot" aria-hidden="true" />
              <h2 id={`${group.id}-title`}>{categoryName(group.id, locale)}</h2>
              {locale === 'zh' ? (
                <span class="group__en">{categories[group.id].en}</span>
              ) : null}
            </div>
            <p class="group__desc">{categoryDescription(group.id, locale)}</p>
          </header>
          <div class="rows">
            {group.items.map((pass, i) => (
              <PassRow pass={pass} index={group.start + i} locale={locale} />
            ))}
          </div>
        </section>
      ))
    }

    <section class="roadmap" id="roadmap" aria-labelledby="roadmap-title">
      <header class="roadmap__head">
        <p class="eyebrow">{t(locale, 'passes.roadmap.eyebrow')}</p>
        <h2 id="roadmap-title">{t(locale, 'passes.roadmap.title')}</h2>
        <p class="muted">{t(locale, 'passes.roadmap.body')}</p>
      </header>

      <ol class="roadmap__list">
        {
          planned.map((item, index) => (
            <li class={`roadmap__item cat-${item.category}`}>
              <span class="roadmap__no">{String(index + 1).padStart(2, '0')}</span>
              <span class="roadmap__name">{item.name}</span>
              <span class="roadmap__zh">{item.title[locale]}</span>
              <span class="roadmap__note">{item.note[locale]}</span>
              <span class="chip roadmap__status">{t(locale, 'passes.roadmap.status')}</span>
            </li>
          ))
        }
      </ol>

      <p class="roadmap__cta">
        <a class="btn btn--ghost" href={url('/about/', locale)}>
          {t(locale, 'passes.roadmap.cta')} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
  }

  .page-head__title {
    margin-top: 10px;
    font-size: clamp(38px, 5.4vw, 60px);
    letter-spacing: -0.03em;
  }

  .page-head__lead {
    margin-top: 14px;
    max-width: 62ch;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .jump__count {
    font-size: 10px;
    opacity: 0.6;
  }

  .group {
    padding-block: clamp(32px, 4.5vw, 52px);
    border-bottom: 1px solid var(--line);
  }

  .group__head {
    display: grid;
    gap: 6px;
    margin-bottom: 22px;
  }

  .group__label {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .group__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat);
    align-self: center;
  }

  .group__label h2 {
    font-size: clamp(22px, 2.6vw, 28px);
  }

  .group__en {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .group__desc {
    font-size: 14.5px;
    color: var(--muted);
    max-width: 68ch;
  }

  .rows {
    margin-top: 6px;
  }

  /* ---------- 路线图 ---------- */
  .roadmap {
    padding-block: clamp(40px, 6vw, 64px);
  }

  .roadmap__head {
    max-width: 640px;
    margin-bottom: 26px;
  }

  .roadmap__head h2 {
    margin-top: 8px;
    font-size: clamp(26px, 3vw, 34px);
  }

  .roadmap__head p {
    margin-top: 10px;
    font-size: 14.5px;
  }

  .roadmap__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .roadmap__item {
    display: grid;
    grid-template-columns: 44px minmax(90px, 0.9fr) minmax(90px, 1fr) minmax(0, 2.4fr) auto;
    align-items: center;
    gap: 14px;
    padding: 13px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .roadmap__no {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .roadmap__name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ink);
  }

  .roadmap__zh {
    color: var(--ink-soft);
  }

  .roadmap__note {
    font-size: 13px;
    color: var(--muted);
  }

  .roadmap__status {
    border-style: dashed;
    color: var(--faint);
  }

  .roadmap__item::before {
    content: '';
    position: absolute;
    left: -12px;
    width: 3px;
    height: 18px;
    border-radius: 2px;
    background: var(--cat);
    opacity: 0.5;
  }

  .roadmap__item {
    position: relative;
  }

  .roadmap__cta {
    margin-top: 26px;
  }

  @media (max-width: 980px) {
    .roadmap__item {
      grid-template-columns: 32px 1fr auto;
      gap: 6px 12px;
    }

    .roadmap__zh {
      grid-column: 2;
    }

    .roadmap__note {
      grid-column: 2 / -1;
    }

    .roadmap__status {
      display: none;
    }
  }
</style>
