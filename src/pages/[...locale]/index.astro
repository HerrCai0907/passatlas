---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PassCard from '../../components/PassCard.astro';
import StepPlayer from '../../components/StepPlayer';
import { getDemo } from '../../demos/registry';
import { pipelinePasses } from '../../data/pipeline';
import { defaultLocale, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { categoryOrder, categoryName } from '../../lib/categories';
import { passSlug, passesForLocale } from '../../lib/passes';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const allPasses = await getCollection('passes', ({ data }) => data.status === 'ready');
const passes = passesForLocale(allPasses, locale);
const featured = passes.slice(0, 3);
const documented = new Set(passes.map((pass) => passSlug(pass)));
const plannedCount = pipelinePasses.filter(
  (item) => !documented.has(item.page ?? item.name),
).length;
const machinePasses = passes.filter((pass) => pass.data.category === 'codegen').length;
const heroDemo = getDemo('hero', locale) ?? getDemo(passes[0]?.data.demo, locale);
---

<BaseLayout locale={locale}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{t(locale, 'home.eyebrow')}</p>
        <h1 class="hero__title">
          <span class="hero__title-en">{t(locale, 'home.titleEn')}</span>
          <span class="hero__title-zh">{t(locale, 'home.title')}</span>
        </h1>
        <p class="lead hero__lead" set:html={t(locale, 'home.lead')} />
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('/passes/mem2reg/', locale)}>
            {t(locale, 'home.start')} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={url('/passes/', locale)}>{t(locale, 'home.browse')}</a>
        </div>
        <dl class="hero__stats">
          <div>
            <dt>{t(locale, 'home.stats.passes')}</dt>
            <dd>{String(passes.length).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>{t(locale, 'home.stats.categories')}</dt>
            <dd>{String(categoryOrder.length).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>{t(locale, 'home.stats.codegen')}</dt>
            <dd>{String(machinePasses).padStart(2, '0')}</dd>
          </div>
        </dl>
      </div>

      <div class="hero__demo">
        {
          heroDemo ? (
            <StepPlayer
              demo={heroDemo}
              locale={locale}
              compact
              autoplay
              loop
              caption={t(locale, 'home.caption')}
              client:load
            />
          ) : null
        }
        <p class="hero__hint">
          <span aria-hidden="true">●</span> {t(locale, 'home.hint')}
        </p>
      </div>
    </div>
  </section>

  <section class="section how">
    <div class="container">
      <header class="sec-head">
        <p class="eyebrow">{t(locale, 'home.how.eyebrow')}</p>
        <h2>{t(locale, 'home.how.title')}</h2>
        <p class="lead">{t(locale, 'home.how.lead')}</p>
      </header>

      <ol class="how__steps">
        <li>
          <span class="how__no">01</span>
          <h3>{t(locale, 'home.how.step1.title')}</h3>
          <p>{t(locale, 'home.how.step1.body')}</p>
        </li>
        <li>
          <span class="how__no">02</span>
          <h3>{t(locale, 'home.how.step2.title')}</h3>
          <p>{t(locale, 'home.how.step2.body')}</p>
        </li>
        <li>
          <span class="how__no">03</span>
          <h3>{t(locale, 'home.how.step3.title')}</h3>
          <p set:html={t(locale, 'home.how.step3.body')} />
        </li>
      </ol>
    </div>
  </section>

  <section class="section atlas">
    <div class="container">
      <header class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">{t(locale, 'home.atlas.eyebrow')}</p>
          <h2>{t(locale, 'home.atlas.title')}</h2>
        </div>
        <a class="btn btn--ghost" href={url('/passes/', locale)}>
          {t(locale, 'home.atlas.all', { count: passes.length })}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </header>

      <nav class="cats" aria-label={t(locale, 'home.atlas.browse')}>
        {
          categoryOrder.map((id) => (
            <a class={`chip chip--cat cat-${id}`} href={`${url('/passes/', locale)}#${id}`}>
              {categoryName(id, locale)}
            </a>
          ))
        }
      </nav>

      <div class="grid">
        {featured.map((pass) => <PassCard pass={pass} locale={locale} />)}
      </div>

      <p class="atlas__more">
        {t(locale, 'home.atlas.pipeline', { count: plannedCount })}
        <a href={`${url('/passes/', locale)}#pipeline`}>
          {t(locale, 'home.atlas.pipelineLink')} <span aria-hidden="true">→</span>
        </a>
      </p>
      <p class="atlas__more">
        {t(locale, 'home.atlas.cfg')}
        <a href={url('/ir/', locale)}>
          {t(locale, 'home.atlas.cfgLink')} <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(44px, 7vw, 92px) clamp(40px, 6vw, 72px);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .hero__title {
    margin-top: 14px;
    display: grid;
    gap: 2px;
    font-size: clamp(46px, 7.4vw, 88px);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .hero__title-en {
    font-family: var(--font-mono);
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .hero__title-zh {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .hero__lead {
    margin-top: 22px;
    max-width: 46ch;
  }

  .hero__lead :global(em) {
    font-style: normal;
    color: var(--accent-strong);
    box-shadow: inset 0 -0.42em 0 var(--accent-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero__stats {
    display: flex;
    gap: 36px;
    margin: 36px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .hero__stats div {
    display: grid;
    gap: 2px;
  }

  .hero__stats dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .hero__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.1;
    color: var(--ink);
  }

  .hero__demo {
    position: relative;
    min-width: 0;
  }

  .hero__demo::before {
    content: '';
    position: absolute;
    inset: -14px;
    z-index: -1;
    border: 1px dashed var(--line-strong);
    border-radius: calc(var(--radius-lg) + 8px);
    opacity: 0.7;
  }

  .hero__hint {
    margin-top: 14px;
    font-size: 12px;
    color: var(--faint);
  }

  .hero__hint span {
    color: var(--ok);
    margin-right: 4px;
    font-size: 9px;
  }

  /* ---------- 通用 section 头 ---------- */
  .sec-head {
    max-width: 680px;
    margin-bottom: clamp(26px, 4vw, 40px);
  }

  .sec-head h2 {
    margin-top: 8px;
    font-size: clamp(28px, 3.4vw, 38px);
  }

  .sec-head .lead {
    margin-top: 12px;
    font-size: 16px;
  }

  .sec-head--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    max-width: none;
  }

  /* ---------- 三步 ---------- */
  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .how__steps li {
    padding: 26px 28px 0 0;
    border-right: 1px solid var(--line);
  }

  .how__steps li:last-child {
    border-right: 0;
  }

  .how__steps li + li {
    padding-left: 28px;
  }

  .how__no {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--accent);
  }

  .how__steps h3 {
    margin-top: 10px;
    font-size: 21px;
  }

  .how__steps p {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--muted);
  }

  .how__steps :global(code) {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-size: 0.86em;
  }

  /* ---------- 目录 ---------- */
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .atlas__more {
    margin-top: 22px;
    font-size: 13px;
    color: var(--muted);
  }

  .atlas__more a {
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: 1px;
  }

  .atlas__more a:hover {
    border-bottom-color: var(--accent);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .how__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .how__steps li,
    .how__steps li + li {
      padding: 22px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .sec-head--split {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__stats {
      gap: 24px;
    }
  }
</style>
