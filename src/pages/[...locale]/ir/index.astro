---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CFGLab from '../../../components/CFGLab';
import { cfgSamples, localizeSamples } from '../../../data/cfg-samples';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const samples = localizeSamples(cfgSamples, locale);
---

<BaseLayout
  title={t(locale, 'ir.metaTitle')}
  description={t(locale, 'ir.metaDescription')}
  locale={locale}
>
  <section class="lab-page">
    <div class="container">
      <header class="lab-page__head">
        <p class="eyebrow">{t(locale, 'ir.eyebrow')}</p>
        <h1>{t(locale, 'ir.heading')}</h1>
        <p class="lead">{t(locale, 'ir.lead')}</p>
        <ul class="lab-page__tips">
          <li><span aria-hidden="true">→</span> {t(locale, 'ir.tip1')}</li>
          <li><span aria-hidden="true">→</span> {t(locale, 'ir.tip2')}</li>
          <li><span aria-hidden="true">→</span> {t(locale, 'ir.tip3')}</li>
        </ul>
      </header>

      <CFGLab samples={samples} locale={locale} client:load />

      <section class="lab-page__note">
        <h2>{t(locale, 'ir.noteTitle')}</h2>
        <p>{t(locale, 'ir.noteBody')}</p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-page {
    padding-block: clamp(36px, 5vw, 64px);
  }

  .lab-page__head {
    max-width: 760px;
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  .lab-page__head h1 {
    margin-top: 10px;
    font-size: clamp(36px, 5.2vw, 56px);
    letter-spacing: -0.03em;
  }

  .lab-page__head .lead {
    margin-top: 14px;
  }

  .lab-page__tips {
    display: grid;
    gap: 4px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--muted);
  }

  .lab-page__tips span {
    color: var(--accent);
    margin-right: 6px;
  }

  .lab-page__tips code {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-size: 0.9em;
  }

  .lab-page__note {
    max-width: var(--wrap-narrow);
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .lab-page__note h2 {
    font-size: 22px;
  }

  .lab-page__note p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--muted);
  }

  .lab-page__note code {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-size: 0.88em;
    color: var(--accent-strong);
  }
</style>
