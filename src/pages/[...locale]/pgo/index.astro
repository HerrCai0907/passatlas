---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PgoSiteRow from '../../../components/PgoSiteRow.astro';
import { pgoComparison, pgoFlow, pgoSite } from '../../../data/pgo';
import { defaultLocale, locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { pgoForLocale, pgoSlug } from '../../../lib/pgo';
import { url } from '../../../lib/url';
import { site } from '../../../site';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const entries = pgoForLocale(
  await getCollection('pgo', ({ data }) => data.status === 'ready'),
  locale,
);

const workflow = `# 1. collect: counters and value sites live in the binary
clang -O2 -fprofile-generate app.c -o app
./app

# 2. merge: raw profiles from several runs can be fed together
llvm-profdata merge -o app.profdata default_*.profraw

# 3. use: the same IR and the same CFG can match the counters
clang -O2 -fprofile-use=app.profdata app.c -o app.pgo

# 4. inspect the metadata instead of guessing
clang -O2 -fprofile-use=app.profdata -S -emit-llvm app.c -o app.pgo.ll
grep -n '!prof' app.pgo.ll`;
---

<BaseLayout
  title={t(locale, 'pgo.metaTitle')}
  description={t(locale, 'pgo.metaDescription')}
  locale={locale}
>
  <header class="pgo-hero">
    <div class="container">
      <p class="eyebrow">{t(locale, 'pgo.eyebrow')}</p>
      <h1 class="pgo-hero__title">{t(locale, 'pgo.heading')}</h1>
      <p class="lead pgo-hero__lead">{t(locale, 'pgo.lead')}</p>

      <div class="pgo-hero__actions">
        <a class="btn btn--primary" href={url('/pgo/function-entry/', locale)}>
          {t(locale, 'pgo.start')} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={url('/passes/', locale)}>{t(locale, 'pgo.browse')}</a>
      </div>

      <p class="pgo-hero__count">
        <span>{site.llvmVersion}</span>
        <span aria-hidden="true">·</span>
        <span>{t(locale, 'pgo.count', { count: entries.length })}</span>
        <span aria-hidden="true">·</span>
        <span>Instrumentation</span>
      </p>
    </div>
  </header>

  <div class="container">
    <blockquote class="why">
      <p>{t(locale, 'pgo.why')}</p>
    </blockquote>

    <section class="flow" aria-labelledby="flow-title">
      <header class="sec-head">
        <p class="eyebrow">{t(locale, 'pgo.flow.eyebrow')}</p>
        <h2 id="flow-title">{t(locale, 'pgo.flow.title')}</h2>
        <p class="lead">{t(locale, 'pgo.flow.lead')}</p>
      </header>

      <ol class="flow__list">
        {
          pgoFlow.map((step) => (
            <li class="flow__step">
              <span class="flow__no">{step.no}</span>
              <h3>{step.title[locale]}</h3>
              <p>{step.body[locale]}</p>
              <pre class="flow__code"><code>{step.code}</code></pre>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sites" aria-labelledby="sites-title">
      <header class="sec-head sec-head--split">
        <div>
          <p class="eyebrow">{t(locale, 'pgo.sites.eyebrow')}</p>
          <h2 id="sites-title">{t(locale, 'pgo.sites.title')}</h2>
        </div>
        <p class="muted sites__lead">{t(locale, 'pgo.sites.lead')}</p>
      </header>

      <div class="sites__rows">
        {
          entries.map((entry, index) => {
            const meta = pgoSite(pgoSlug(entry));
            return meta ? (
              <PgoSiteRow entry={entry} meta={meta} index={index + 1} locale={locale} />
            ) : null;
          })
        }
      </div>
    </section>

    <section class="merge" aria-labelledby="merge-title">
      <header class="sec-head">
        <p class="eyebrow">{t(locale, 'pgo.merge.eyebrow')}</p>
        <h2 id="merge-title">{t(locale, 'pgo.merge.title')}</h2>
        <p class="lead">{t(locale, 'pgo.merge.lead')}</p>
      </header>

      <div class="merge__grid">
        <pre class="merge__code"><code>{workflow}</code></pre>
        <div class="merge__note">
          <p>{t(locale, 'pgo.merge.note')}</p>
          <p class="merge__hint">{t(locale, 'pgo.merge.hint')}</p>
        </div>
      </div>
    </section>

    <section class="compare" aria-labelledby="compare-title">
      <header class="sec-head">
        <p class="eyebrow">{t(locale, 'pgo.compare.eyebrow')}</p>
        <h2 id="compare-title">{t(locale, 'pgo.compare.title')}</h2>
        <p class="lead">{t(locale, 'pgo.compare.lead')}</p>
      </header>

      <div class="compare__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">{t(locale, 'pgo.compare.dimension')}</th>
              <th scope="col">{t(locale, 'pgo.compare.ir')}</th>
              <th scope="col">{t(locale, 'pgo.compare.sample')}</th>
            </tr>
          </thead>
          <tbody>
            {
              pgoComparison.map((row) => (
                <tr>
                  <th scope="row">{row.label[locale]}</th>
                  <td data-label={t(locale, 'pgo.compare.ir')}>{row.ir[locale]}</td>
                  <td data-label={t(locale, 'pgo.compare.sample')}>{row.sample[locale]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="compare__foot">{t(locale, 'pgo.compare.foot')}</p>
    </section>

    <section class="next" aria-labelledby="next-title">
      <h2 id="next-title">{t(locale, 'pgo.related.title')}</h2>
      <div class="next__grid">
        <a class="next__card" href={url('/passes/sample-profile-inline/', locale)}>
          <span class="next__kicker">Sample PGO</span>
          <span class="next__title">{t(locale, 'pgo.related.sample')}</span>
          <span class="next__arrow" aria-hidden="true">→</span>
        </a>
        <a class="next__card" href={url('/passes/inliner/', locale)}>
          <span class="next__kicker">Inliner</span>
          <span class="next__title">{t(locale, 'pgo.related.inliner')}</span>
          <span class="next__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pgo-hero {
    padding-block: clamp(40px, 6vw, 72px) clamp(26px, 4vw, 42px);
    border-bottom: 1px solid var(--line);
  }

  .pgo-hero__title {
    max-width: 18ch;
    margin-top: 10px;
    font-size: clamp(40px, 6.4vw, 68px);
    letter-spacing: -0.035em;
  }

  .pgo-hero__lead {
    max-width: 70ch;
    margin-top: 18px;
  }

  .pgo-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .pgo-hero__count {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  .why {
    max-width: 860px;
    margin: clamp(28px, 4vw, 40px) 0 0;
    padding: 18px 22px;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--accent-soft);
  }

  .why p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .flow,
  .sites,
  .merge,
  .compare,
  .next {
    padding-block: clamp(40px, 6vw, 64px);
  }

  .flow,
  .sites,
  .merge,
  .compare {
    border-bottom: 1px solid var(--line);
  }

  .sec-head {
    max-width: 780px;
    margin-bottom: 26px;
  }

  .sec-head h2 {
    margin-top: 8px;
    font-size: clamp(26px, 3vw, 34px);
  }

  .sec-head .lead {
    margin-top: 12px;
    font-size: 15px;
  }

  .sec-head--split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 10px clamp(24px, 4vw, 56px);
    max-width: none;
  }

  .sites__lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
  }

  .flow__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow__step {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 16px 15px 14px;
    border: 1px solid var(--line);
    border-top: 2px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .flow__no {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .flow__step h3 {
    font-size: 17px;
  }

  .flow__step p {
    flex: 1;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .flow__code {
    margin: 4px 0 0;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--accent-strong);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .merge__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 20px;
    align-items: start;
  }

  .merge__code {
    margin: 0;
    padding: 20px 22px;
    border: 1px solid var(--code-border);
    border-left: 3px solid color-mix(in srgb, var(--accent) 46%, var(--code-border));
    border-radius: var(--radius);
    background: var(--code-bg);
    box-shadow: var(--shadow-sm);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--code-text);
    tab-size: 2;
  }

  .merge__note {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .merge__note p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .merge__hint {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: 12.5px !important;
    color: var(--muted) !important;
  }

  .merge__hint code {
    color: var(--accent-strong);
  }

  .compare__scroll {
    overflow-x: auto;
  }

  .compare table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .compare th,
  .compare td {
    padding: 11px 13px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .compare thead th {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom-color: var(--line-strong);
  }

  .compare tbody th {
    width: 20%;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--faint);
  }

  .compare td {
    color: var(--ink-soft);
  }

  .compare tbody tr:hover {
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }

  .compare__foot {
    max-width: 76ch;
    margin-top: 14px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--faint);
  }

  .next h2 {
    font-size: clamp(22px, 2.6vw, 28px);
  }

  .next__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  .next__card {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.16s var(--ease),
      transform 0.16s var(--ease);
  }

  .next__card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .next__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .next__title {
    padding-right: 22px;
    font-size: 15px;
    line-height: 1.55;
  }

  .next__arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    font-size: 14px;
    color: var(--faint);
  }

  @media (max-width: 960px) {
    .flow__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .sec-head--split {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .merge__grid {
      grid-template-columns: 1fr;
    }

    .flow__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .compare__scroll {
      overflow: visible;
    }

    .compare table,
    .compare thead,
    .compare tbody,
    .compare tr,
    .compare th,
    .compare td {
      display: block;
    }

    .compare thead {
      display: none;
    }

    .compare tbody tr {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }

    .compare tbody th {
      width: auto;
      padding: 0 0 6px;
      border: 0;
      color: var(--accent);
      font-size: 10.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .compare td {
      padding: 2px 0;
      border: 0;
    }

    .compare td::before {
      content: attr(data-label);
      display: inline-block;
      min-width: 86px;
      margin-right: 8px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.04em;
      color: var(--faint);
    }
  }

  @media (max-width: 560px) {
    .flow__list {
      grid-template-columns: 1fr;
    }

    .next__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
