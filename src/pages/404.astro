---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeMeta } from '../i18n/config';
import { t } from '../i18n/ui';
import { url } from '../lib/url';

// 404 只有一个页面（GitHub Pages 只认根目录的 404.html），
// 所以这里用默认语言呈现，并给英文读者一个明确的入口。
const locale = 'zh' as const;
---

<BaseLayout
  title="404"
  description={t(locale, 'notFound.metaDescription')}
  locale={locale}
  noindex
>
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">{t(locale, 'notFound.eyebrow')}</p>
      <h1 class="nf__code">404</h1>
      <p class="lead nf__lead">{t(locale, 'notFound.lead')}</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href={url('/passes/', locale)}>
          {t(locale, 'notFound.back')} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={url('/', locale)}>{t(locale, 'notFound.home')}</a>
        <a
          class="btn btn--ghost"
          href={url('/', 'en')}
          hreflang={localeMeta.en.htmlLang}
          lang={localeMeta.en.htmlLang}
        >
          English
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: 62vh;
    padding-block: 60px;
  }

  .nf__inner {
    max-width: 560px;
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: clamp(80px, 16vw, 148px);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--ink);
    margin-top: 8px;
  }

  .nf__code::after {
    content: ' ';
    display: inline-block;
    width: 0.12em;
    height: 0.72em;
    margin-left: 0.06em;
    background: var(--accent);
    animation: caret 1.1s steps(2) infinite;
  }

  .nf__lead {
    margin-top: 14px;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__code::after {
      animation: none;
    }
  }
</style>
